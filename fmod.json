{
    "duplicateStrategies": {
        "gradle.properties": "properties"
    },

    "facetPlatform": "FABRIC",
    "minecraft": "1.21.1",

    "remap": {
        "enabled": false,
        "tinyJar": "https://maven.lemonnik.dev/releases/me/jxsnack/tinymojmap/1.21.1/mojmap-parchment-1.21.1.jar",
        "tinyPath": "mappings/mappings.tiny",
        "from": "intermediary",
        "to": "named"
    },

    "retain": [".gradle", "run"],
    "extract": {
        "src/main/resources/fabric.mod.json": "resources/fabric.mod.json",
        "src/main/resources/modid.mixins.json": "resources/%flatmod:rootid%.mixins.json",
        ".gitignore": ".gitignore"
    },

    "indirect" : {
        "maven": [
            "https://maven.fabricmc.net",
            "https://repo.maven.apache.org/maven2/",
            "https://plugins.gradle.org/m2",
            "https://libraries.minecraft.net/"
        ],
        "require": [
            "maven@net.fabricmc:fabric-loader 0.20.1",

            "maven@org.ow2.asm:asm 9.10.1",
            "maven@org.ow2.asm:asm-analysis 9.10.1",
            "maven@org.ow2.asm:asm-commons 9.10.1",
            "maven@org.ow2.asm:asm-tree 9.10.1",
            "maven@org.ow2.asm:asm-util 9.10.1",
            "maven@net.fabricmc:sponge-mixin 0.17.5+mixin.0.8.7"
        ]
    },

    "init": {
        "maven": [],
        "require": [
            "maven@net.fabricmc.fabric-api:fabric-api 0.116.17+1.21.1"
        ]
    }
}