{
    "duplicateStrategies": {
        "gradle.properties": "properties"
    },

    "facetPlatform": "NEOFORGE",
    "minecraft": "1.21.1",

    "remap": {
        "enabled": false,
        "tinyJar": "https://maven.lemonnik.dev/releases/me/jxsnack/tinymojmap/1.21.1/mojmap-parchment-1.21.1.jar",
        "tinyPath": "mappings/mappings.tiny",
        "from": "intermediary",
        "to": "named"
    },

    "retain": [".gradle", "run"],
    "extract": {
        "src/main/resources/META-INF/neoforge.mods.toml": "resources/META-INF/neoforge.mods.toml",
        "src/main/resources/modid.mixins.json": "resources/%flatmod:rootid%.mixins.json",
        ".gitignore": ".gitignore"
    },

    "indirect" : {
        "maven": [
            "https://maven.neoforged.net/releases",
            "https://maven.fabricmc.net",
            "https://repo.maven.apache.org/maven2/",
            "https://plugins.gradle.org/m2",
            "https://libraries.minecraft.net/"
        ],
        "require": [
            "maven@net.neoforged:neoforge:sources 21.1.265",

            "maven@net.neoforged.fancymodloader:earlydisplay 4.0.45",
            "maven@net.neoforged.fancymodloader:loader 4.0.45",
            "maven@net.neoforged.accesstransformers:at-modlauncher 10.0.1",
            "maven@net.neoforged:accesstransformers 10.0.1",
            "maven@net.neoforged:bus 8.0.5",
            "maven@net.neoforged:coremods 7.0.3",
            "maven@cpw.mods:modlauncher 11.0.5",
            "maven@net.neoforged:mergetool 2.0.0",
            "maven@com.electronwill.night-config:toml 3.8.3",
            "maven@com.electronwill.night-config:core 3.8.3",
            "maven@net.neoforged:JarJarSelector 0.4.1",
            "maven@net.neoforged:JarJarMetadata 0.4.1",
            "maven@net.neoforged:JarJarFileSystems 0.4.1",
            "maven@org.apache.maven:maven-artifact 3.8.5",
            "maven@net.jodah:typetools 0.6.3",
            "maven@net.minecrell:terminalconsoleappender 1.3.0",
            "maven@net.fabricmc:sponge-mixin 0.16.4+mixin.0.8.7",
            "maven@org.openjdk.nashorn:nashorn-core 15.4",
            "maven@cpw.mods:bootstraplauncher 2.0.2",
            "maven@cpw.mods:securejarhandler 3.0.8",

            "maven@org.ow2.asm:asm 9.10.1",
            "maven@org.ow2.asm:asm-analysis 9.10.1",
            "maven@org.ow2.asm:asm-commons 9.10.1",
            "maven@org.ow2.asm:asm-tree 9.10.1",
            "maven@org.ow2.asm:asm-util 9.10.1",

            "maven@org.antlr:antlr4-runtime 4.13.1",
            "maven@net.minecraftforge:srgutils 0.4.15",
            "maven@org.codehaus.plexus:plexus-utils 3.3.0",
            "maven@com.machinezoo.noexception:noexception 1.7.1",

            "maven@org.apache.commons:commons-lang3 3.14.0",
            "maven@net.sf.jopt-simple:jopt-simple 5.0.4",
            "maven@commons-io:commons-io 2.15.1",
            "maven@com.mojang:logging 1.2.7",
            "maven@org.apache.logging.log4j:log4j-slf4j2-impl 2.22.1",
            "maven@org.apache.logging.log4j:log4j-core 2.22.1",
            "maven@org.apache.logging.log4j:log4j-api 2.22.1",
            "maven@com.google.guava:guava 32.1.2-jre",
            "maven@com.google.guava:failureaccess 1.0.1",
            "maven@com.google.guava:listenablefuture 9999.0-empty-to-avoid-conflict-with-guava",
            "maven@com.google.code.gson:gson 2.10.1",
            "maven@org.slf4j:slf4j-api 2.0.9",
            "maven@org.jline:jline-reader 3.20.0",
            "maven@org.jline:jline-terminal 3.20.0",
            "maven@com.google.code.findbugs:jsr305 3.0.2",
            "maven@org.checkerframework:checker-qual 3.33.0",
            "maven@com.google.errorprone:error_prone_annotations 2.18.0",
            "maven@com.google.j2objc:j2objc-annotations 2.8"
        ]
    },

    "init": {
        "maven": [],
        "require": []
    }
}